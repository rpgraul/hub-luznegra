# ============================================================
# Supabase — Hub (Editora Luz Negra)
# Copie para .env e preencha com os valores do seu projeto.
# ============================================================

# URL e chave publishable (públicas, usadas pelo frontend)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_EXEMPLO_PUBLICO

# Chave secreta (APENAS backend / Edge Functions / scripts locais)
# ATENÇÃO: nunca use no frontend — ela ignora a RLS.
# Sem prefixo VITE_, o Vite NÃO a embarca no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_EXEMPLO_SOMENTE_SERVIDOR